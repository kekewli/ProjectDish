<Window x:Class="ProjectDish.MVVM.Views.PasswordResetView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectDish.MVVM.Views"
        xmlns:converters="clr-namespace:ProjectDish.Core.Converters"
        mc:Ignorable="d"
        Title="Восстановление пароля" Height="450" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:StepToVisibilityConverter x:Key="StepConverter"/>
        <converters:MultiBindingConverter x:Key="MultiBindConverter"/>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="#FF2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5,0,5,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF388E3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1B5E20"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#FFE0E0E0"/>
                                <Setter Property="Foreground" Value="#FFA0A0A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для всех PasswordBox -->
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="0,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FFAAAAAA"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FF2E7D32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Стиль для всех TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="0,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FFAAAAAA"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FF2E7D32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20" Background="White" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.2"/>
        </Border.Effect>
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Восстановление доступа" FontSize="22" FontWeight="Bold" Foreground="#FF2E7D32" HorizontalAlignment="Center"/>
                <TextBlock Text="Введите данные для сброса пароля" Foreground="Gray" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,30,0,0">
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepConverter}, ConverterParameter=1}">
                    <TextBlock Text="Email" Foreground="Gray" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepConverter}, ConverterParameter=2}">
                    <TextBlock Text="Код из письма" Foreground="Gray" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding ResetCode, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Новый пароль" Foreground="Gray" Margin="0,15,0,5"/>
                    <PasswordBox x:Name="PasswordBox"/>
                    <TextBlock Text="Повторите пароль" Foreground="Gray" Margin="0,15,0,5"/>
                    <PasswordBox x:Name="ConfirmPasswordBox"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                <!-- Кнопки для Шага 1 -->
                <Button Content="Отправить код" Command="{Binding SendCodeCommand}" IsDefault="True"
                        Visibility="{Binding CurrentStep, Converter={StaticResource StepConverter}, ConverterParameter=1}" 
                        Style="{StaticResource ActionButton}"/>

                <!-- Кнопки для Шага 2 -->
                <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepConverter}, ConverterParameter=2}">
                    <Button Content="Изменить пароль" Command="{Binding ResetPasswordCommand}" IsDefault="True"
                            Style="{StaticResource ActionButton}">
                        <Button.CommandParameter>
                            <MultiBinding Converter="{StaticResource MultiBindConverter}">
                                <Binding ElementName="PasswordBox"/>
                                <Binding ElementName="ConfirmPasswordBox"/>
                            </MultiBinding>
                        </Button.CommandParameter>
                    </Button>
                </StackPanel>

                <Button Content="Отмена" 
                        Command="{Binding CloseCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Background="Transparent" BorderThickness="0" Foreground="Gray" Margin="0,15,0,0"/>
            </StackPanel>

            <Grid Grid.RowSpan="3" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="Отправка..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="#FF2E7D32"/>
            </Grid>
        </Grid>
    </Border>
</Window>