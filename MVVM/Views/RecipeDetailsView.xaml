<Window x:Class="ProjectDish.MVVM.Views.RecipeDetailsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:vm="clr-namespace:ProjectDish.MVVM.ViewModels"
        mc:Ignorable="d"
        Title="Детали рецепта" Height="700" Width="850"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True"
        Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="#FF2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF388E3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1B5E20"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#FFE0E0E0"/>
                                <Setter Property="Foreground" Value="#FFA0A0A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToggleButton" x:Key="ActionToggleButton">
            <Setter Property="Background" Value="#FF2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1B5E20"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF388E3C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#FFE0E0E0"/>
                                <Setter Property="Foreground" Value="#FFA0A0A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="StarButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="LightGray"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Content" Value="☆"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root"
                        Background="Transparent"
                        Padding="2"
                        Width="36"
                        Height="36">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="starScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>

                            <TextBlock x:Name="starText"
                               Text="{TemplateBinding Content}"
                               FontSize="{TemplateBinding FontSize}"
                               Foreground="{TemplateBinding Foreground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#1A000000"/>
                                <Setter Property="Foreground" Value="Gold"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="starScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1.12"
                                                     Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="starScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1.12"
                                                     Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="starScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1"
                                                     Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="starScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1"
                                                     Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#22000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFilled}" Value="True">
                    <Setter Property="Foreground" Value="Goldenrod"/>
                    <Setter Property="Content" Value="★"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="VoteButton">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Width" Value="25"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="12.5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="TextBoxWithHint">
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="5"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            <TextBlock x:Name="HintText" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" IsHitTestVisible="False" Foreground="Gray" Margin="8,5,0,0" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, RelativeSource={RelativeSource AncestorType=TextBox}}" Value=""/>
                                                    <Condition Binding="{Binding IsFocused, RelativeSource={RelativeSource AncestorType=TextBox}}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border CornerRadius="20" Background="White" Margin="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="25,20,25,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Style="{StaticResource ActionToggleButton}" IsChecked="{Binding IsCommentsPanelVisible}"
                                  Width="50" Height="50" Padding="0" Margin="0,0,20,0" VerticalAlignment="Center"
                                  Content="💬" FontSize="24"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding RecipeName}" FontSize="24" FontWeight="Bold" Foreground="#FF2E7D32" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Category}" FontSize="16" Foreground="Gray" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
                <Separator Grid.Row="0" VerticalAlignment="Bottom" Margin="25,0"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="25,20,25,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <Border CornerRadius="10" Height="220" Background="#F0F0F0">
                                <Image Source="{Binding ImageUrl, TargetNullValue='pack://application:,,,/Resources/placeholder.png'}" Stretch="UniformToFill"/>
                            </Border>
                            <Border Background="#FAFAFA" CornerRadius="8" Padding="10" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="Рейтинг" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                        <TextBlock Text="★" FontSize="20" Foreground="Goldenrod" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding AverageRating, StringFormat={}{0:F1}}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Margin="5,0,2,0"/>
                                        <TextBlock Text="/ 5.0" Foreground="Gray" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <ToggleButton Margin="0,15,0,5" 
                                                  Visibility="{Binding CanUserRate, Converter={StaticResource BoolToVisConverter}}" 
                                                  IsChecked="{Binding IsRatingPanelVisible, Mode=TwoWay}" 
                                                  Content="Оценить рецепт" 
                                                  Style="{StaticResource ActionToggleButton}"/>

                                    <Border Margin="0,12,0,0"
                                        CornerRadius="12"
                                        Background="#FAFAFA"
                                        BorderBrush="#E8E8E8"
                                        BorderThickness="1"
                                        Padding="10"
                                        ClipToBounds="True">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                        </Border.RenderTransform>

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Setter Property="MaxHeight" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRatingPanelVisible}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="0:0:0.20"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                 To="80"
                                                 Duration="0:0:0.20"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1"
                                                 Duration="0:0:0.20"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1"
                                                 Duration="0:0:0.20"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0"
                                                 Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                 To="0"
                                                 Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="0.95"
                                                 Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="0.95"
                                                 Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <ItemsControl ItemsSource="{Binding Stars}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource StarButton}"
                                                        Command="{Binding DataContext.RateRecipeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Value}"
                                                        IsEnabled="{Binding DataContext.CanUserRate, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Описание" FontWeight="SemiBold" FontSize="16"/>
                            <TextBox Text="{Binding Description}" Margin="0,5,0,20" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto" MinHeight="180" Background="#FDFDFD" BorderThickness="0"/>
                            <TextBlock Text="Ингредиенты" FontWeight="SemiBold" FontSize="16"/>
                            <TextBox Text="{Binding Ingredients}" Margin="0,5,0,0" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto" MinHeight="180" Background="#FDFDFD" BorderThickness="0"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="15" BorderThickness="0,1,0,0" BorderBrush="#EEE">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Закрыть" 
                                Command="{Binding CloseCommand}" 
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                                Background="Transparent" BorderThickness="0" Foreground="Gray" FontSize="14" Cursor="Hand" Padding="10,5">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="Gray"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#FF2E7D32"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Панель комментариев (без изменений) -->
        <Border Width="350" HorizontalAlignment="Left" Margin="10,10,0,10" CornerRadius="20,0,0,20" 
                Background="#FDFDFD" Panel.ZIndex="10">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="3" BlurRadius="15" Opacity="0.15" Direction="0"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform X="-350"/>
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCommentsPanelVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" To="0" Duration="0:0:0.3" DecelerationRatio="0.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" To="-350" Duration="0:0:0.3" AccelerationRatio="0.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Комментарии" FontSize="20" FontWeight="Bold" Foreground="#FF2E7D32" VerticalAlignment="Center"/>

                    <Button Grid.Column="1" Content="—"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="Gray"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="5"
                        Command="{Binding CloseCommentsCommand}"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Focusable="False">          
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="Gray"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#FF2E7D32"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Foreground" Value="#FF1B5E20"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding Comments}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="15,10" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" Opacity="0.8">
                                        <TextBlock Text="{Binding UserName}" FontWeight="SemiBold"/>
                                        <TextBlock Text=" • " Margin="5,0"/>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='dd.MM.yy HH:mm'}" Foreground="Gray"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding CommentText}" TextWrapping="Wrap" Margin="0,8,0,8"/>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <Button Content="+">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource VoteButton}">
                                                    <Setter Property="Command" Value="{Binding VoteCommand}"/>
                                                    <Setter Property="CommandParameter" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUpvoted}" Value="True">
                                                            <Setter Property="Background" Value="#C8E6C9"/>
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <TextBlock Text="{Binding Rating}" Width="30" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <Button Content="−">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource VoteButton}">
                                                    <Setter Property="Command" Value="{Binding VoteCommand}"/>
                                                    <Setter Property="CommandParameter" Value="-1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDownvoted}" Value="True">
                                                            <Setter Property="Background" Value="#FFCDD2"/>
                                                            <Setter Property="Foreground" Value="#D32F2F"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="🗑" Background="Transparent" BorderThickness="0" Foreground="Gray" Opacity="0.5" Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisConverter}}" Command="{Binding DeleteCommand}" Margin="15,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="2" Padding="15" BorderThickness="0,1,0,0" BorderBrush="#EEE" Visibility="{Binding CanUserPostComment, Converter={StaticResource BoolToVisConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewCommentText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="80" Tag="Написать комментарий..." Style="{StaticResource TextBoxWithHint}"/>
                        <Button Grid.Column="1" Content="➤" Command="{Binding PostCommentCommand}" Style="{StaticResource ActionButton}" Width="40" Height="40" Padding="0" Margin="10,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" Panel.ZIndex="20">
            <Border Background="White" CornerRadius="10" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="⏳" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Загрузка..." FontWeight="Bold" Foreground="#FF2E7D32"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>